# ── Core ─────────────────────────────────────────────
DATABASE_URL=postgres://postgres:radar@localhost:5432/radar
APP_URL=http://localhost:3000
# 32+ random chars. Encrypts OAuth tokens and CMS credentials at rest. Required in production.
RADAR_SECRET_KEY=
# DEV ONLY: 1 = run every external integration against deterministic local stubs (no keys needed). Never set in production.
RADAR_DEV_STUBS=0
WORKER_CONCURRENCY=4

# ── Sign in with Google + Search Console (one Google Cloud OAuth client) ──
# Authorized redirect URIs: {APP_URL}/api/auth/google/callback and {APP_URL}/api/oauth/gsc/callback
# Scopes: openid email profile, https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Radar's AI models (Settings → AI models) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Optional: map catalogue ids to provider ids, e.g. {"gpt-6-sol":"gpt-6-sol-2026-09-01"}
AI_MODEL_MAP=
# Optional: 1 = if the chosen model's provider has no key, use a configured one
RADAR_AI_FALLBACK=0
# Optional image model for Photography / Illustration (uses OPENAI_API_KEY)
OPENAI_IMAGE_MODEL=gpt-image-1

# ── AI Visibility (measurement targets; ChatGPT/Claude/Grok reuse the keys above) ──
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
# Model id queried for each assistant (OpenAI Responses + web_search, Perplexity Sonar, Gemini + google_search, Anthropic + web_search, xAI Responses + web_search)
VIS_CHATGPT_MODEL=gpt-6-sol
VIS_PERPLEXITY_MODEL=sonar-pro
VIS_GEMINI_MODEL=gemini-2.5-flash
VIS_CLAUDE_MODEL=claude-sonnet-5-5
VIS_GROK_MODEL=grok-4.7

# ── Keyword data, videos, authority ──
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
YOUTUBE_API_KEY=
OPENPAGERANK_API_KEY=

# ── Website analysis crawler (onboarding / Re-analyze). Respects robots.txt for this agent. ──
CRAWLER_USER_AGENT=RadarBot/1.0 (+https://radar.app/bot)

# ── Daily Brief sources ──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:radar:1.0 (by /u/your-account)
X_BEARER_TOKEN=

# ── Blog connector OAuth apps (redirect: {APP_URL}/api/oauth/{provider}/callback) ──
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
WIX_CLIENT_ID=
WIX_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
WPCOM_CLIENT_ID=
WPCOM_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Shopify Admin GraphQL API version used by the Shopify connector
SHOPIFY_API_VERSION=2026-07
# 1 = let blog connectors reach private/internal hosts (self-hosted WordPress/Ghost on a LAN). Off by default.
RADAR_ALLOW_PRIVATE_HOSTS=0

# ── Email (invites, partner notices, feature requests) ──
RESEND_API_KEY=
MAIL_FROM=Radar <hello@yourdomain.com>
SUPPORT_INBOX=support@yourdomain.com

# ── Storage (local disk by default) ──
STORAGE_DIR=.data/uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_URL=
