# ── Core ─────────────────────────────────────────────
DATABASE_URL=postgres://postgres:radar@localhost:5432/radar
APP_URL=http://localhost:3000
# 32+ random chars. Encrypts OAuth tokens and CMS credentials at rest. Required in production.
RADAR_SECRET_KEY=
# DEV ONLY: 1 = run every external integration against deterministic local stubs (no keys needed). Never set in production.
RADAR_DEV_STUBS=0
# DEV ONLY, with RADAR_DEV_STUBS=1: blog connectors that skip their stub and call the real platform while everything else
# (AI, OAuth, data providers) stays stubbed, e.g. wordpress,ghost,webhook against the local Docker harness
# (scripts/connectors/README.md). Credential-based types only: an OAuth type listed here gets no real token and fails.
# Has no effect without dev stubs (production never stubs).
RADAR_REAL_CONNECTORS=
WORKER_CONCURRENCY=4

# ── Sign in with Google + Search Console (one Google Cloud OAuth client) ──
# Authorized redirect URIs: {APP_URL}/api/auth/google/callback and {APP_URL}/api/oauth/gsc/callback
# Scopes: openid email profile, https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Radar's AI models (Settings → AI models) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Optional: map catalogue ids to provider ids, e.g. {"gpt-6-sol":"gpt-6-sol-2026-09-01"}
AI_MODEL_MAP=
# Optional: 1 = if the chosen model's provider has no key, use a configured one
# AI calls fail over automatically between configured providers (Anthropic, OpenAI, xAI) on missing keys, billing/auth errors or outages.
# Optional image model for Photography / Illustration (uses OPENAI_API_KEY)
OPENAI_IMAGE_MODEL=gpt-image-1

# ── OpenRouter (optional primary route for every AI call) ──
# When set, writing/research calls, images and AI Visibility go through OpenRouter first. Each attempt tries the model
# on OpenRouter, then the same model on its direct provider (keys above), then the next fallback model. Billing/auth
# errors pause OpenRouter for 10 minutes; a model OpenRouter doesn't list goes straight to its direct provider.
# Leave empty to use the direct providers only (unchanged behaviour).
OPENROUTER_API_KEY=
# Optional: JSON map of catalogue id → OpenRouter id, merged over the built-in map; "" turns OpenRouter off for a model.
# e.g. {"gpt-6-sol":"openai/gpt-6-sol","grok-4.6":""}
OPENROUTER_MODEL_MAP=
# Optional: OpenRouter image model (POST /api/v1/images). Default google/gemini-nano-banana-2.1. Must accept the aspect
# ratios 1:1, 4:3, 3:4, 3:2, 2:3, 16:9 and 9:16.
OPENROUTER_IMAGE_MODEL=
# Optional: JSON map of AI Visibility engine → OpenRouter model; "" = that engine uses its direct API only.
# Defaults: {"ChatGPT":"openai/gpt-6-sol","Claude":"anthropic/claude-sonnet-5.5","Grok":"x-ai/grok-4.7","Gemini":"google/gemini-4-argon","Perplexity":"perplexity/sonar-pro"}
OPENROUTER_VIS_MODELS=

# ── AI Visibility (measurement targets; ChatGPT/Claude/Grok reuse the keys above; all five go via OpenRouter first when OPENROUTER_API_KEY is set) ──
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
# Model id queried for each assistant (OpenAI Responses + web_search, Perplexity Sonar, Gemini + google_search, Anthropic + web_search, xAI Responses + web_search)
VIS_CHATGPT_MODEL=gpt-6-sol
VIS_PERPLEXITY_MODEL=sonar-pro
VIS_GEMINI_MODEL=gemini-flash-latest
VIS_CLAUDE_MODEL=claude-sonnet-5-5
VIS_GROK_MODEL=grok-4.7

# ── Keyword data, videos, authority ──
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
YOUTUBE_API_KEY=
OPENPAGERANK_API_KEY=

# ── Website analysis crawler (onboarding / Re-analyze). Respects robots.txt for this agent. ──
CRAWLER_USER_AGENT=RadarBot/1.0 (+https://radar.app/bot)

# ── Daily Brief sources ──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:radar:1.0 (by /u/your-account)
X_BEARER_TOKEN=

# ── Blog connector OAuth apps (redirect: {APP_URL}/api/oauth/{provider}/callback) ──
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
WIX_CLIENT_ID=
WIX_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
WPCOM_CLIENT_ID=
WPCOM_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Shopify Admin GraphQL API version used by the Shopify connector
SHOPIFY_API_VERSION=2026-07
# 1 = let blog connectors reach private/internal hosts (self-hosted WordPress/Ghost on a LAN). Off by default.
RADAR_ALLOW_PRIVATE_HOSTS=0

# ── Social channels: post to X and LinkedIn from Radar (redirect: {APP_URL}/api/oauth/{x|linkedin|linkedin_page}/callback) ──
# Feature flag, evaluated per business: empty/off = off everywhere (default); all = everyone; or a comma-separated list of
# business ids and/or owner emails (opt-in group). Same value on web and worker.
RADAR_SOCIAL_PUBLISHING=
# X OAuth 2.0 app (Web App = confidential client). Scopes: tweet.read tweet.write users.read media.write offline.access.
# Separate from X_BEARER_TOKEN above, which stays the Daily Brief's search token (one X app can issue both).
# (XAPP_CLIENT_ID / XAPP_CLIENT_SECRET are accepted too)
X_CLIENT_ID=
X_CLIENT_SECRET=
# LinkedIn profile app (Share on LinkedIn + Sign In with LinkedIn using OpenID Connect). Scopes: openid profile w_member_social
# (LINKEDINAPP_CLIENT_ID / LINKEDINAPP_CLIENT_SECRET are accepted too)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn page app — a separate app with Community Management API only. Scopes: w_organization_social rw_organization_admin r_basicprofile
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=
# LinkedIn-Version header for every REST call. LinkedIn retires versions after ~12 months: bump it at least yearly.
LINKEDIN_API_VERSION=202610

# ── Email (invites, partner notices, feature requests) ──
RESEND_API_KEY=
MAIL_FROM=Radar <hello@yourdomain.com>
SUPPORT_INBOX=support@yourdomain.com
# Emails allowed to read impact metrics at /api/admin/metrics (comma-separated). Empty disables the endpoint.
ADMIN_EMAILS=

# ── Storage (local disk by default) ──
STORAGE_DIR=.data/uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_URL=
# Credentials for the bucket (read by the AWS SDK)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Signup gating, anonymous onboarding, $1-then-trial billing (.factory/marketing-trial-gating/architecture.md) ──
# off (default) | on | a comma-separated list of emails (gate only those accounts, e.g. the owner's own trial run).
# Read at call time; set the same value on web and worker. `on` without a payment provider is treated as off (logged).
RADAR_BILLING=off
# Stripe over REST (no SDK). A restricted key is recommended: write Customers (incl. balance transactions),
# PaymentIntents, PaymentMethods, Subscriptions; read Invoices, Prices. With no key and RADAR_DEV_STUBS=1 (never in
# production) an in-memory stub provider runs instead (stub cards: see docs/CONTRACTS.md → Billing).
STRIPE_SECRET_KEY=
# Read on the server and passed to the trial page as a prop (deliberately not NEXT_PUBLIC_*).
STRIPE_PUBLISHABLE_KEY=
# whsec_… of the {APP_URL}/api/billing/webhook endpoint. Unset = every delivery is refused with 400.
STRIPE_WEBHOOK_SECRET=
# The $50/month recurring USD price. The first billing call logs an error if it differs from what the pages show.
STRIPE_PRICE_ID=
# Pinned Stripe-Version. The code reads Basil-or-later shapes; review the changelog before moving to a new major line.
STRIPE_API_VERSION=2026-05-27.dahlia
# ISO timestamp: also comp owners of active businesses created before it. Migration 0008 comps only owners who had an
# active business when it ran, so decide this BEFORE RADAR_BILLING=on (docs/LAUNCH.md §7c). Recommended: the flip time, so
# everyone who joined while the flag was off stays free. Unset = migration rows only; later owners are asked to start a trial.
RADAR_BILLING_GRANDFATHER_BEFORE=
# X-Forwarded-For entries counted from the right to find the client IP (1 = the address Railway's edge saw; 2 behind a CDN).
RADAR_TRUSTED_PROXY_HOPS=1
# Circuit breaker for site analyses by guests and accounts without access, per hour across everyone (503 "busy" past it).
RADAR_ANALYSIS_GLOBAL_PER_HOUR=300
# Cloudflare Turnstile secret for the guest human check. Seam only (no widget ships), so leave unset: the check passes.
TURNSTILE_SECRET_KEY=
