# ── Core ─────────────────────────────────────────────
DATABASE_URL=postgres://postgres:radar@localhost:5432/radar
APP_URL=http://localhost:3000
# 32+ random chars. Encrypts OAuth tokens and CMS credentials at rest. Required in production.
RADAR_SECRET_KEY=
# DEV ONLY: 1 = run every external integration against deterministic local stubs (no keys needed). Never set in production.
RADAR_DEV_STUBS=0
# DEV ONLY, with RADAR_DEV_STUBS=1: blog connectors that skip their stub and call the real platform while everything else
# (AI, OAuth, data providers) stays stubbed, e.g. wordpress,ghost,webhook against the local Docker harness
# (scripts/connectors/README.md). Credential-based types only: an OAuth type listed here gets no real token and fails.
# Has no effect without dev stubs (production never stubs).
RADAR_REAL_CONNECTORS=
WORKER_CONCURRENCY=4

# ── Sign in with Google + Search Console (one Google Cloud OAuth client) ──
# Authorized redirect URIs: {APP_URL}/api/auth/google/callback and {APP_URL}/api/oauth/gsc/callback
# Scopes: openid email profile, https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Radar's AI models (Settings → AI models) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Optional: map catalogue ids to provider ids, e.g. {"gpt-6-sol":"gpt-6-sol-2026-09-01"}
AI_MODEL_MAP=
# Optional: 1 = if the chosen model's provider has no key, use a configured one
# AI calls fail over automatically between configured providers (Anthropic, OpenAI, xAI) on missing keys, billing/auth errors or outages.
# ── Model tiers (all optional; read at call time; set the same values on web and worker) ──
# Radar picks the model by task: a small model for scoring/classification/extraction (utility), the default below for
# everything else (standard), and the strongest model for article drafts, refresh drafts and calendar topics (premium).
# Comma list of tiers that are on. Unset = utility,premium. "premium" = utility off; "utility" = premium off.
# "off" = the routing before tiers (writing default gpt-6-sol, research claude-opus-5.5, no effort setting) and every
# RADAR_AI_* variable below is ignored.
RADAR_AI_TIERS=
# Models, as catalogue ids from Settings → AI models (an id outside the catalogue is ignored with a warning).
# Utility never reads a business's Settings choice. Default claude-haiku-5.5, then gpt-6-luna, then grok-4.7.
RADAR_AI_UTILITY_MODEL=
# Standard default per kind, shown in Settings when a business has not picked a model. Default claude-opus-5.5 for both.
RADAR_AI_WRITING_MODEL=
RADAR_AI_RESEARCH_MODEL=
# Premium chain: default claude-fable-5.2, then gpt-6-astra, then the standard model. A business that picked a model
# other than the standard default keeps it for premium tasks. Direct Anthropic calls to claude-fable-5.2 need 30-day
# data retention on the Anthropic organization (a zero-retention org gets a 400 and the call moves to the fallback).
RADAR_AI_PREMIUM_MODEL=
RADAR_AI_PREMIUM_FALLBACK=
# Reasoning effort on premium attempts: low | medium | high | xhigh. Default medium.
RADAR_AI_PREMIUM_EFFORT=
# "off" = never send a reasoning-effort field on any route (utility and premium otherwise send one; a provider that
# rejects it is asked again without it).
RADAR_AI_EFFORT=
# Optional image model for Photography / Illustration (uses OPENAI_API_KEY). Default gpt-image-2.5-flare
# (gpt-image-1 was shut down on 2026-10-23).
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# A new social pack asks the image model once and crops that image to each platform's size. "per_platform" = one
# generation per platform, as before. Read at call time; set the same value on web and worker.
RADAR_SOCIAL_PACK_IMAGE=

# ── OpenRouter (optional primary route for every AI call) ──
# When set, writing/research calls, images and AI Visibility go through OpenRouter first. Each attempt tries the model
# on OpenRouter, then the same model on its direct provider (keys above), then the next fallback model. Billing/auth
# errors pause OpenRouter for 10 minutes; a model OpenRouter doesn't list goes straight to its direct provider.
# Leave empty to use the direct providers only (unchanged behaviour).
OPENROUTER_API_KEY=
# Optional: JSON map of catalogue id → OpenRouter id, merged over the built-in map; "" turns OpenRouter off for a model.
# e.g. {"gpt-6-sol":"openai/gpt-6-sol","grok-4.6":""}
OPENROUTER_MODEL_MAP=
# Optional: OpenRouter image model (POST /api/v1/images). Default google/gemini-nano-banana-2.1. Must accept the aspect
# ratios 1:1, 4:3, 3:4, 3:2, 2:3, 16:9 and 9:16.
OPENROUTER_IMAGE_MODEL=
# Optional: JSON map of AI Visibility engine → OpenRouter model; "" = that engine uses its direct API only.
# Defaults: {"ChatGPT":"openai/gpt-6-sol","Claude":"anthropic/claude-sonnet-5.5","Grok":"x-ai/grok-4.7","Gemini":"google/gemini-4-argon","Perplexity":"perplexity/sonar-pro"}
OPENROUTER_VIS_MODELS=

# ── AI Visibility (measurement targets; ChatGPT/Claude/Grok reuse the keys above; all five go via OpenRouter first when OPENROUTER_API_KEY is set) ──
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
# Model id queried for each assistant (OpenAI Responses + web_search, Perplexity Sonar, Gemini + google_search, Anthropic + web_search, xAI Responses + web_search)
VIS_CHATGPT_MODEL=gpt-6-sol
VIS_PERPLEXITY_MODEL=sonar-pro
VIS_GEMINI_MODEL=gemini-flash-latest
VIS_CLAUDE_MODEL=claude-sonnet-5-5
VIS_GROK_MODEL=grok-4.7
# Scheduled collection is weekly: on each business's Sunday night (02:00–05:59 in its timezone), skipped only when a
# full run started on the Saturday before or earlier that Sunday. A business whose last full run that collected anything
# is 8 or more days old (a Sunday that was missed, failed, or came back empty because every assistant failed) is
# collected on the next night. A prompt a user adds is collected at once. "nightly" restores the schedule
# before that (active businesses every night, idle ones weekly) with no new code. Read by the worker on every scheduler
# tick. The site, the app and the emails say weekly either way.
RADAR_VISIBILITY_CADENCE=

# ── Keyword data, videos, authority ──
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
YOUTUBE_API_KEY=
OPENPAGERANK_API_KEY=

# ── Website analysis crawler (onboarding / Re-analyze). Respects robots.txt for this agent. ──
CRAWLER_USER_AGENT=RadarBot/1.0 (+https://radar.app/bot)

# ── Daily Brief sources ──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:radar:1.0 (by /u/your-account)
X_BEARER_TOKEN=

# ── Blog connector OAuth apps (redirect: {APP_URL}/api/oauth/{provider}/callback) ──
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
WIX_CLIENT_ID=
WIX_CLIENT_SECRET=
# Wix: the share-install-link ID, required while the app is unlisted (dev.wix.com → app → Distribution → share link GUID)
WIX_SHARE_URL_ID=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
WPCOM_CLIENT_ID=
WPCOM_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ── Sandbox publisher for GitHub connections (scripts/connectors/README.md, "Sandbox publisher for GitHub") ──
# Rollout switch, read on every attempt. Unset/empty/off = the planner (default). all = every business.
# Otherwise a comma-separated list of business ids. With it on but something below missing or invalid, publishing
# falls back to the planner and reports the variable names.
RADAR_PUBLISH_SANDBOX=off
# Worker only. Daytona API key of a Tier 3+ organization (lower tiers cannot restrict sandbox egress). Never on web or model-proxy.
DAYTONA_API_KEY=
# Worker only. Runner snapshot UUID printed by `node scripts/operations/build-publisher-snapshot.mjs` (a UUID, never a snapshot name).
RADAR_PUBLISH_SANDBOX_SNAPSHOT_ID=
# Worker only. The dedicated model-proxy service: https://<its own host>/model. This host is the sandbox's only network.
RADAR_PUBLISH_MODEL_PROXY_URL=
# Worker and model-proxy, the same value on both, 32+ characters (openssl rand -base64 48). Not RADAR_SECRET_KEY.
RADAR_PUBLISH_CAPABILITY_SECRET=
# Optional. Anthropic model (catalogue id) the agent runs on, and the per-run spend and model-call caps.
# RADAR_PUBLISH_SANDBOX_MODEL=claude-opus-5.5
# RADAR_PUBLISH_SANDBOX_MAX_USD=6
# RADAR_PUBLISH_SANDBOX_MAX_CALLS=200
# Optional, development and QA only (ignored in production): directory for agent transcripts, which contain repository source.
# RADAR_PUBLISH_SANDBOX_TRANSCRIPT_DIR=.data/sandbox-publisher/transcripts
# Shopify Admin GraphQL API version used by the Shopify connector
SHOPIFY_API_VERSION=2026-10
# 1 = let blog connectors reach private/internal hosts (self-hosted WordPress/Ghost on a LAN). Off by default.
RADAR_ALLOW_PRIVATE_HOSTS=0

# ── Social channels: post to X and LinkedIn from Radar (redirect: {APP_URL}/api/oauth/{x|linkedin|linkedin_page}/callback) ──
# Feature flag, evaluated per business: empty/off = off everywhere (default); all = everyone; or a comma-separated list of
# business ids and/or owner emails (opt-in group). Same value on web and worker.
RADAR_SOCIAL_PUBLISHING=
# X OAuth 2.0 app (Web App = confidential client). Scopes: tweet.read tweet.write users.read media.write offline.access.
# Separate from X_BEARER_TOKEN above, which stays the Daily Brief's search token (one X app can issue both).
# (XAPP_CLIENT_ID / XAPP_CLIENT_SECRET are accepted too)
X_CLIENT_ID=
X_CLIENT_SECRET=
# LinkedIn profile app (Share on LinkedIn + Sign In with LinkedIn using OpenID Connect). Scopes: openid profile w_member_social
# (LINKEDINAPP_CLIENT_ID / LINKEDINAPP_CLIENT_SECRET are accepted too)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn page app — a separate app with Community Management API only. Scopes: w_organization_social rw_organization_admin r_basicprofile
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=
# LinkedIn-Version header for every REST call. LinkedIn retires versions after ~12 months: bump it at least yearly.
LINKEDIN_API_VERSION=202610

# ── Email (account confirmation, lifecycle, recovery, invites, partner notices, feature requests) ──
# Account signup/confirmation email fails closed without a real sender in production.
# Existing send-only Resend keys use native delivery suppression only on recognized restricted_api_key lookup responses.
# Activate the finite five-lesson sequence for verified registered accounts after release review. Default off.
RADAR_EDUCATION_EMAILS=0
RESEND_API_KEY=
MAIL_FROM=Radar <hello@yourdomain.com>
SUPPORT_INBOX=support@thally.io
# Failure alerts: enabled by default in production; off in development/tests and always off in development stubs.
# on/1 = explicitly enable; off/0 = disable. Configure the same values on web and worker.
RADAR_FAILURE_ALERTS=
RADAR_FAILURE_ALERT_EMAIL=kenny@thally.io
# Emails allowed to read impact metrics at /api/admin/metrics (comma-separated). Empty disables the endpoint.
ADMIN_EMAILS=

# ── Storage (local disk by default) ──
STORAGE_DIR=.data/uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_URL=
# Credentials for the bucket (read by the AWS SDK)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Signup gating, anonymous onboarding, $1-then-trial billing (.factory/marketing-trial-gating/architecture.md) ──
# off (default) | on | a comma-separated list of emails (gate only those accounts, e.g. the owner's own trial run).
# Read at call time; set the same value on web and worker. `on` without a payment provider is treated as off (logged).
RADAR_BILLING=off
# Hours a paying subscription keeps full access after a renewal payment fails (status past_due), with an in-app banner.
# Default 48. 0 locks at once (the behaviour before grace existed). Applies only to active → past_due; a first charge
# that fails at the end of a trial still locks at once. Read at call time; set the same value on web and worker.
RADAR_PAST_DUE_GRACE_HOURS=
# Stripe over REST (no SDK). A restricted runtime key needs write Customers (incl. balance transactions),
# PaymentIntents, PaymentMethods, Subscriptions, Invoices and Billing Portal Sessions; read Prices.
# Provisioning additionally needs Products, Prices, Webhook Endpoints and Billing Portal Configurations access.
# With no key and RADAR_DEV_STUBS=1 (never in
# production) an in-memory stub provider runs instead (stub cards: see docs/CONTRACTS.md → Billing).
STRIPE_SECRET_KEY=
# Read on the server and passed to the trial page as a prop (deliberately not NEXT_PUBLIC_*).
STRIPE_PUBLISHABLE_KEY=
# whsec_… of the {APP_URL}/api/billing/webhook endpoint. Unset = every delivery is refused with 400.
STRIPE_WEBHOOK_SECRET=
# Dedicated customer portal configuration (billing:setup preserves any existing default; Stripe's first config becomes default).
# Enables invoice history, card updates and cancellation at period end. Empty uses Stripe's default configuration.
STRIPE_PORTAL_CONFIGURATION_ID=
# Active, licensed, per-unit $50 USD every month (interval_count=1). A mismatch refuses payment with 503.
STRIPE_PRICE_ID=
# Pinned Stripe-Version. The code reads Basil-or-later shapes; review the changelog before moving to a new major line.
STRIPE_API_VERSION=2026-05-27.dahlia
# ISO timestamp: also comp owners of active businesses created before it. Migration 0008 comps only owners who had an
# active business when it ran, so decide this BEFORE RADAR_BILLING=on (docs/LAUNCH.md §7c). Recommended: the flip time, so
# everyone who joined while the flag was off stays free. Unset = migration rows only; later owners are asked to start a trial.
RADAR_BILLING_GRANDFATHER_BEFORE=
# X-Forwarded-For entries counted from the right to find the client IP (1 = the address Railway's edge saw; 2 behind a CDN).
RADAR_TRUSTED_PROXY_HOPS=1
# Circuit breaker for site analyses by guests and accounts without access, per hour across everyone (503 "busy" past it).
RADAR_ANALYSIS_GLOBAL_PER_HOUR=300
# Signup always uses shared IP, email and global rate limits. Turnstile is an optional extra layer.
# 1 = require the managed widget on signup and confirmation-email requests; 0 = rate limits only.
# Enabled mode fails closed on missing keys or failed challenges; it never falls back automatically.
RADAR_SIGNUP_TURNSTILE=0
# Public site key is passed from server pages; secret stays server-only. Both required when enabled.
# Widget domain must cover APP_URL's hostname. Server checks hostname and action turnstile-spin-v2.
# Use separate Cloudflare test keys locally; only explicit nonproduction RADAR_DEV_STUBS=1 bypasses signup checks.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Legacy anonymous guest human check remains separate and has no widget yet. Leave unset.
GUEST_TURNSTILE_SECRET_KEY=
