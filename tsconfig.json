{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2023"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noImplicitAny": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-brief/types/**/*.ts",
    ".next-content/types/**/*.ts",
    ".next-onboarding/types/**/*.ts",
    ".next-performance/types/**/*.ts",
    ".next-platform/types/**/*.ts",
    ".next-publishing/types/**/*.ts",
    ".next-social/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-publishing-turbo/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "prototype"
  ]
}
