{
  "name": "radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev -p ${PORT:-3000}\" \"tsx watch src/worker/main.ts\"",
    "dev:web": "next dev",
    "worker": "tsx src/worker/main.ts",
    "build": "next build",
    "start": "next start",
    "start:all": "concurrently -k -n web,worker \"next start\" \"tsx src/worker/main.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "db:push": "drizzle-kit push --force",
    "billing:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/billing.ts setup",
    "billing:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/billing.ts check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fontsource/roboto": "^5.3.0",
    "@napi-rs/canvas": "^0.1.80",
    "@stripe/stripe-js": "9.17.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.0",
    "framer-api": "^5.1.0",
    "geist": "^1.8.1",
    "jose": "^6.0.0",
    "next": "15.5.28",
    "pg": "^8.13.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "robots-parser": "^3.0.1",
    "simple-icons": "^16.35.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.0",
    "playwright": "^1.64.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "22.x"
  }
}
