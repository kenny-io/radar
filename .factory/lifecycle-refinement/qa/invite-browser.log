async function login(p:any,email:string){await p.getByRole('textbox',{name:'Work email'}).fill(email);await p.getByLabel('Password',{exact:true}).fill(password);const response=p.waitForResponse((r:any)=>r.url().endsWith('/api/auth/signin'));await p.getByRole('button',{name:'Sign in',exact:true}).click();const r=await response,h=await r.request().allHeaders();const body=r.ok()?{}:await r.json();evidence.auth.push({status:r.status(),origin:h.origin,site:h['sec-fetch-site'],requestOrigin:new URL(r.url()).origin,pageOrigin:new URL(p.url()).origin,code:body.code,error:body.error});if(!r.ok())throw Error('Authfailure '+JSON.stringify(evidence.auth.at(-1)));}
