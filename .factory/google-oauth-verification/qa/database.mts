const out='.factory/google-oauth-verification/qa',F=new Fixtures(),results:any[]=[];
let owner:any,biz:any,pack:string,now:Date;const API='QA_REMOTE_API_CANARY',LOCAL='QA_OWNER_CAPTION';let calls={refresh:0,profile:0,revoke:0,upload:0},active=0,peak=0;
const baseHooks={...youtubeRetentionHooks};
const barrier=()=>{let enter!:()=>void,release!:()=>void;return{at:new Promise<void>(r=>enter=r),release:()=>release(),wait:async()=>{enter();await new Promise<void>(r=>release=r)}}};
const tokens=(stamp=now.getTime())=>({access_token:'qa-local-token',refresh_token:'qa-local-refresh',expires_at:Date.now()+3600e3,youtube:{profileFetchedAt:stamp,authorizationCheckedAt:stamp}});
const acct=async(bid=biz.id,patch:any={})=>(await db.insert(S.socialAccounts).values({businessId:bid,ch:'youtube',remoteId:API,name:API,handle:'@'+API,...tokenFields(tokens()),...patch}).returning())[0];
const pub=async(a:any,patch:any={})=>(await db.insert(P).values({businessId:biz.id,sid:`s:${pack}:youtube`,src:'pack',platform:'youtube',ch:'youtube',acctId:a?.id??null,acctLabel:API,status:'posted',date:now.toISOString().slice(0,10),time:'12:00',dueAt:now,postedAt:now,remoteId:API,remoteUrl:'https://youtube.com/watch?v='+API,...patch}).returning())[0];
const read=async(id:string)=>(await db.select().from(P).where(eq(P.id,id)))[0];
const accounts=async(bid=biz.id)=>db.select().from(S.socialAccounts).where(eq(S.socialAccounts.businessId,bid));
function mp4(){const box=(t:string,d:Buffer)=>{const b=Buffer.alloc(d.length+8);b.writeUInt32BE(b.length);b.write(t,4);d.copy(b,8);return b};const m=Buffer.alloc(20);m.writeUInt32BE(1000,12);m.writeUInt32BE(6000,16);const h=Buffer.alloc(12);h.write('vide',8);return Buffer.concat([box('ftyp',Buffer.from('isom0000')),box('moov',Buffer.concat([box('mvhd',m),box('trak',box('mdia',box('hdlr',h)))])),box('mdat',Buffer.from([1]))])}
const target=async()=>{await attachVideo(await getBiz(biz.id),pack,'youtube',mp4());return(await loadTarget(biz.id,`s:${pack}:youtube`))!};
async function begin(){now=new Date();biz=await F.biz(owner);pack='qa-retention-'+crypto.randomUUID();calls={refresh:0,profile:0,revoke:0,upload:0};active=peak=0;await db.insert(S.socialPacks).values({id:pack,businessId:biz.id,data:{id:pack,name:'QA lifecycle',order:['youtube'],posts:{youtube:{text:LOCAL,style:'branded',seed:1,imageUrl:null,copiedAt:null,v:0,publishOptions:{title:'Owner title',privacy:'private',madeForKids:false}}}} as any});youtubeRetentionHooks.refresh=async t=>{calls.refresh++;active++;peak=Math.max(active,peak);await new Promise(r=>setTimeout(r,10));active--;return{...t,access_token:'qa-renewed'}};youtubeRetentionHooks.profile=async()=>{calls.profile++;return{remoteId:API,name:'Fresh QA channel',handle:'@fresh'}};youtubeRetentionHooks.revoke=async()=>{calls.revoke++};setAdapterForTests('youtube',{...youtubeAdapter,refresh:t=>youtubeRetentionHooks.refresh(t),revoke:t=>youtubeRetentionHooks.revoke(t),publish:async()=>{calls.upload++;return{remoteId:API,url:'https://youtube.com/watch?v='+API}}});}
async function test(name:string,fn:()=>Promise<any>){await begin();try{results.push({name,pass:true,detail:await fn()});}catch(e:any){results.push({name,pass:false,error:e.stack});}finally{setAdapterForTests('youtube',null);Object.assign(youtubeRetentionHooks,baseHooks);await db.delete(S.businesses).where(eq(S.businesses.id,biz.id));await db.delete(S.jobs).where(inArray(S.jobs.kind,['youtube.verify','youtube.expire','youtube.revoke']));await db.delete(S.cronMarks).where(sql`key LIKE 'youtube.%'`);}console.log(JSON.stringify(results.at(-1)));}
owner=await F.user();
try{
await test('Q6 scoped cleanup scrubs API copies, preserves owner media/settings and foreign platform/tenant',async()=>{const a=await acct(),t=await target(),p=await pub(a,{payload:{text:LOCAL,video:t.video,options:t.options,providerRef:API},errDetail:API});const foreign=await F.biz(owner),fa=await acct(foreign.id);const x=(await db.insert(S.socialAccounts).values({businessId:biz.id,ch:'x',remoteId:'x-safe',name:'X safe',tokensEnc:encrypt({access_token:'x-safe'})}).returning())[0];await savePendingSocial(biz.id,owner.id,'youtube',{tokens:tokens(),id:{remoteId:API,name:API}});await db.insert(S.events).values({businessId:biz.id,kind:'social.posted',ref:p.sid,props:{ch:'youtube',remoteId:API,url:API}});await db.execute(sql`UPDATE social_packs SET data=jsonb_set(data,'{posts,youtube,pub}',${JSON.stringify({url:API,acctLabel:API})}::jsonb) WHERE id=${pack}`);let committed=false;youtubeRetentionHooks.revoke=async()=>{assert.equal((await accounts()).filter(a=>a.ch==='youtube').length,0);committed=true;};await cleanupYouTube({bid:biz.id,reason:'disconnect',now});assert(committed);const row=await read(p.id);assert(!JSON.stringify(row).includes(API));assert.equal(row.payload?.text,LOCAL);assert(row.payload?.video);assert.equal(row.payload?.options?.title,'Owner title');assert.equal(row.payload?.youtubeRetention?.noResend,true);assert.equal((await accounts()).length,1);assert.equal((await accounts())[0].id,x.id);assert.equal((await accounts(foreign.id))[0].tokensEnc,fa.tokensEnc);assert.equal((await db.select().from(S.oauthStates).where(eq(S.oauthStates.businessId,biz.id))).length,0);const data=(await db.select().from(S.socialPacks).where(eq(S.socialPacks.id,pack)))[0].data;assert(!JSON.stringify(data).includes(API));const ws=await loadWorkspace(biz.id,owner.id,'Owner');assert(!JSON.stringify(ws.social).includes(API));await db.delete(S.businesses).where(eq(S.businesses.id,foreign.id));return{committedBeforeRevoke:true,preservedOwnerVideo:true};});
await test('Q6 permanent no-resend survives reconnect and every claim/schedule/recovery',async()=>{const a=await acct(),t=await target(),p=await pub(a,{status:'sending',stage:'create',remoteId:null,remoteUrl:null,postedAt:null,claimedAt:new Date(Date.now()-200000),payload:{providerRef:API,processingStartedAt:Date.now()}});await cleanupYouTube({bid:biz.id,reason:'disconnect'});const b=await acct();assert.equal(await claimManual({bid:biz.id,t,acct:b,userId:owner.id,tz:'UTC'}),null);const r=await resolve(biz.id,t.sid,b.id);for(const auto of [true,false])assert.equal(await writeScheduled(db,{biz:await getBiz(biz.id),r,date:now.toISOString().slice(0,10),time:'12:00',userId:auto?null:owner.id,auto}),null);assert.equal(await claimScheduled(p.id),null);assert.equal(await recoverStuck(p.id),null);assert.equal(calls.upload,0);const marker=(await read(p.id)).payload!.youtubeRetention!;assert.deepEqual(Object.keys(marker).sort(),['needsApproval','noResend','reason','scrubbedAt']);return{guardedPaths:5,noProviderCreate:true};});
await test('Q6 unsent draft needs explicit new approval, automatic claim cannot resurrect',async()=>{const a=await acct(),t=await target(),p=await pub(a,{status:'scheduled',remoteId:null,remoteUrl:null,postedAt:null});await cleanupYouTube({bid:biz.id,reason:'disconnect'});const b=await acct(),r=await resolve(biz.id,t.sid,b.id),business=await getBiz(biz.id);assert.equal(await claimScheduled(p.id),null);assert.equal(await writeScheduled(db,{biz:business,r,date:now.toISOString().slice(0,10),time:'12:00',auto:true,userId:null}),null);const approved=await writeScheduled(db,{biz:business,r,date:now.toISOString().slice(0,10),time:'12:00',userId:owner.id});assert(approved);assert.equal(approved.payload?.youtubeRetention?.needsApproval,false);return{explicitApprovalRequired:true};});
await test('Q6 upload completion racing disconnect never restores receipt or retries',async()=>{const a=await acct(),t=await target(),gate=barrier();setAdapterForTests('youtube',{...youtubeAdapter,refresh:t=>youtubeRetentionHooks.refresh(t),publish:async(ctx,p)=>{calls.upload++;await ctx.beforeCreate!();await p.progress!(API);await gate.wait();return{remoteId:API,url:API}}});const claimed=await claimManual({bid:biz.id,t,acct:a,userId:owner.id,tz:'UTC'});assert(claimed);const pending=runSend(claimed,{manual:true});await gate.at;await cleanupYouTube({bid:biz.id,reason:'disconnect'});gate.release();await pending;const row=await read(claimed.id);assert(!JSON.stringify(row).includes(API));assert.equal(row.payload?.youtubeRetention?.noResend,true);assert.equal(calls.upload,1);return{lateWriteDiscarded:true};});
await test('Q6 status completion racing disconnect cannot reintroduce references',async()=>{const a=await acct(),gate=barrier();setAdapterForTests('youtube',{...youtubeAdapter,resume:async()=>{await gate.wait();return{remoteId:API,url:API}}});const p=await pub(a,{status:'sending',stage:'create',remoteId:null,remoteUrl:null,postedAt:null,claimedAt:new Date(Date.now()-200000),attemptKey:crypto.randomUUID(),payload:{providerRef:API,processingStartedAt:Date.now()}});const pending=recoverStuck(p.id);await gate.at;await cleanupYouTube({bid:biz.id,reason:'disconnect'});gate.release();await pending;assert(!JSON.stringify(await read(p.id)).includes(API));return{lateStatusDiscarded:true};});
await test('Q6 late profile from prior token generation cannot overwrite reconnected account',async()=>{const a=await acct(),gate=barrier();youtubeRetentionHooks.profile=async()=>{await gate.wait();return{remoteId:API,name:'STALE_NAME'}};const pending=verifyYouTubeAccount(a.id,now);await gate.at;await cleanupYouTube({bid:biz.id,reason:'disconnect'});const replacement=await acct();gate.release();assert.equal(await pending,'retry');assert.equal((await accounts())[0].tokensEnc,replacement.tokensEnc);assert.equal((await accounts())[0].name,API);return{generationProtected:true};});
await test('Q6 invalid_grant scrubs while configuration hold persists and only valid read clears',async()=>{let a=await acct();const t=await target();await pub(a);youtubeRetentionHooks.refresh=async()=>{throw new YouTubeTokenError('configuration',401)};assert.equal(await verifyYouTubeAccount(a.id,now),'retry');let row=(await accounts())[0];assert(row.expired);assert.equal(acctPublic(row).verificationHold,true);assert.equal(await claimManual({bid:biz.id,t,acct:row,userId:owner.id,tz:'UTC'}),null);const old=decrypt<any>(row.tokensEnc).youtube;assert.equal(old.profileFetchedAt,now.getTime());youtubeRetentionHooks.refresh=async t=>({...t,access_token:'recovered'});assert.equal(await verifyYouTubeAccount(a.id,now),'fresh');assert.equal((await accounts())[0].expired,false);youtubeRetentionHooks.refresh=async()=>{throw new YouTubeTokenError('revoked',400)};assert.equal(await verifyYouTubeAccount(a.id,now),'revoked');assert.equal((await accounts()).length,0);assert(!JSON.stringify(await read((await db.select().from(P).where(eq(P.businessId,biz.id)))[0].id)).includes(API));return{holdAndRecovery:true,definitiveScrub:true};});
await test('Q6 transient failure keeps grant and timestamps; API401 forces one fresh retry',async()=>{const a=await acct();for(const status of [429,500,503]){youtubeRetentionHooks.refresh=async()=>{throw new YouTubeTokenError('retry',status)};assert.equal(await verifyYouTubeAccount(a.id,now),'retry');assert.equal((await accounts())[0].tokensEnc,a.tokensEnc);}let n=0;youtubeRetentionHooks.refresh=async t=>{calls.refresh++;return{...t,access_token:'retry-read'}};youtubeRetentionHooks.profile=async()=>{if(++n===1)throw new YouTubeTokenError('revoked',401);return{remoteId:API,name:'Recovered'}};assert.equal(await verifyYouTubeAccount(a.id,now),'fresh');assert.equal(calls.refresh,2);assert.equal(n,2);return{transientNoPurge:true,read401Recovered:true};});
await test('Q6 day28 hard expiry uses old profile despite rotated token/new updatedAt and hides before sweep',async()=>{const old=new Date(now.getTime()-D28),a=await acct(biz.id,{...tokenFields(tokens(old.getTime())),createdAt:old,updatedAt:now});const projected=acctPublic(a);assert(!JSON.stringify(projected).includes(API));await expireYouTubeCaches(new Date(old.getTime()+D28-1));assert.equal((await accounts()).length,1);await expireYouTubeCaches(now);assert.equal((await accounts()).length,0);return{exactBoundary:true,readSuppressed:true};});
await test('Q6 receipt expiry preserves fresh connection, owner draft and posted fact',async()=>{const a=await acct(),old=new Date(now.getTime()-D28),p=await pub(a,{postedAt:old,updatedAt:now});assert.equal(pubOf(p,[acctPublic(a)]).url,null);const out=await expireYouTubeCaches(now);assert.equal(out.accounts,0);assert.equal((await accounts()).length,1);const row=await read(p.id);assert.equal(row.status,'posted');assert.equal(row.remoteUrl,null);assert.equal(row.payload?.youtubeRetention?.noResend,true);return{freshAccountPreserved:true};});
await test('Q6 malformed profile timestamp fails closed and unstamped recent connection remains viable',async()=>{const a=await acct(biz.id,{...tokenFields({access_token:'x',refresh_token:'y'}),createdAt:now});assert.equal(await verifyYouTubeAccount(a.id,now),'fresh');await db.update(S.socialAccounts).set(tokenFields({...tokens(),youtube:{profileFetchedAt:NaN,authorizationCheckedAt:now.getTime()}})).where(eq(S.socialAccounts.id,a.id));await expireYouTubeCaches(now);assert.equal((await accounts()).length,0);return{legacyInitialized:true,malformedScrub:true};});
await test('Q6 revoke transient intent is encrypted, global, bounded and wiped on expiry/exhaustion',async()=>{await acct();youtubeRetentionHooks.revoke=async()=>{throw new YouTubeTokenError('retry',503)};await cleanupYouTube({bid:biz.id,reason:'disconnect',now});assert.equal((await accounts()).length,0);let j=(await db.select().from(S.jobs).where(eq(S.jobs.kind,'youtube.revoke')))[0];assert.equal(j.businessId,null);assert(j.payload.tokenEnc);assert(!JSON.stringify(j.payload).includes('qa-local-token'));assert.equal(j.payload.expiresAt,now.getTime()+H24);await expireYouTubeCaches(new Date(now.getTime()+H24));j=(await db.select().from(S.jobs).where(eq(S.jobs.id,j.id)))[0];assert.deepEqual(j.payload,{});await acct();const result=await db.transaction(tx=>scrubYouTubeData(tx,{bid:biz.id,reason:'disconnect',now}));assert.equal(await revokeYouTubeJob(result.revokeJobIds[0],now,true),'failed');assert.deepEqual((await db.select().from(S.jobs).where(eq(S.jobs.id,result.revokeJobIds[0])))[0].payload,{});return{retryExpires24h:true,terminalWiped:true};});
await test('Q6 deleted-business cleanup commits immediately and restoration requires reconnect',async()=>{await acct();const p=await pub(null);await deleteBusiness(owner.id,biz.id,{domain:biz.domain});assert.equal((await accounts()).length,0);assert(!JSON.stringify(await read(p.id)).includes(API));await restoreBusiness(owner.id,biz.id);assert.equal((await accounts()).length,0);assert((await db.select().from(S.socialPacks).where(eq(S.socialPacks.id,pack)))[0].data.posts.youtube.text===LOCAL);return{deleteBeforePurge:true,restoreNoGrant:true};});
await test('Q6 global registered queue verifies >batch held off-flag unpaid accounts and deleted business',async()=>{const extra:any[]=[];for(let i=0;i<13;i++){const b=await F.biz(owner);extra.push(b);await acct(b.id,{expired:true});}const deleted=await F.biz(owner,{status:'deleted'});extra.push(deleted);await acct(deleted.id);process.env.RADAR_SOCIAL_PUBLISHING='off';process.env.RADAR_BILLING='on';try{await youtubeRetentionTick(now);let runs=0;for(;;){const next=(await db.select().from(S.jobs).where(and(eq(S.jobs.kind,'youtube.verify'),eq(S.jobs.status,'queued'))).orderBy(S.jobs.createdAt))[0];if(!next)break;assert.equal(next.businessId,null);await runJobNow(next.id);assert.equal((await db.select().from(S.jobs).where(eq(S.jobs.id,next.id)))[0].status,'done');if(++runs>10)throw Error('queue continuation did not finish');}assert(runs>=2);const as=await db.select().from(S.socialAccounts).where(inArray(S.socialAccounts.businessId,extra.map(x=>x.id)));assert.equal(as.length,13);assert(as.every(a=>!a.expired));assert.equal(calls.profile,13);assert(peak<=2);assert.equal(calls.upload,0);return{globalRuns:runs,checked:13,maxParallel:peak,neverPublished:true};}finally{process.env.RADAR_SOCIAL_PUBLISHING='all';process.env.RADAR_BILLING='off';for(const b of extra)await db.delete(S.businesses).where(eq(S.businesses.id,b.id));}});
await test('Q6 >100 expiry continuations scrub disconnected old receipts/events/legacy snapshots without starving',async()=>{const a=await acct();const old=new Date(now.getTime()-D28);await db.insert(P).values(Array.from({length:207},(_,i)=>({businessId:biz.id,sid:`s:qa-old-${i}-${pack}:youtube`,src:'pack' as const,ch:'youtube' as const,platform:'youtube' as const,acctLabel:API,status:'posted' as const,date:now.toISOString().slice(0,10),time:'12:00',dueAt:now,postedAt:old,remoteId:API,remoteUrl:API})));let r=await expireYouTubeCaches(now),passes=1;while(r.next&&passes++<10)r=await expireYouTubeCaches(now,r.next);assert(passes>=3);const rows=await db.select().from(P).where(eq(P.businessId,biz.id));assert.equal(rows.length,207);assert(!JSON.stringify(rows).includes(API));assert.equal((await accounts())[0].id,a.id);return{receipts:207,passes};});
await test('Q6 contact dry-run/apply validates local tenant and safe aggregate report',async()=>{const a=await acct();await pub(a);const before=await accounts();await runYouTubeDeletion(['--business',biz.id]);assert.equal((await accounts())[0].tokensEnc,before[0].tokensEnc);await assert.rejects(()=>runYouTubeDeletion(['--business',biz.id,'--apply','--confirm',crypto.randomUUID()]));const foreign=await F.biz(owner),fa=await acct(foreign.id);await assert.rejects(()=>runYouTubeDeletion(['--business',biz.id,'--account',fa.id,'--apply','--confirm',biz.id]));await runYouTubeDeletion(['--business',biz.id,'--account',a.id,'--apply','--confirm',biz.id]);assert.equal((await accounts()).length,0);assert.equal((await accounts(foreign.id)).length,1);const report=await youtubeRetentionReport(now);assert(!JSON.stringify(report).includes(API));assert(!JSON.stringify(report).includes(biz.id));await db.delete(S.businesses).where(eq(S.businesses.id,foreign.id));return{dryRunUnchanged:true,confirmationAndScopeValidated:true};});
}finally{await F.cleanup();await fs.writeFile(out+'/database-results.json',JSON.stringify({at:new Date().toISOString(),results},null,2));await pool.end();}
