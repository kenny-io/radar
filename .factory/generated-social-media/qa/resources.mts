import assert from'node:assert/strict';import fs from'node:fs/promises';import os from'node:os';import{randomUUID}from'node:crypto';import{pool}from'../../../src/server/db/index';import{renderMedia}from'../../../src/server/services/social/media/render';import{timelineFor}from'../../../src/server/services/social/media/timeline';const f=JSON.parse(await fs.readFile('.data/generated-media-qa/fixture.json','utf8')),v=JSON.parse(await fs.readFile('.data/generated-media-qa/video-pack.json','utf8')),plan=JSON.parse(await fs.readFile('/tmp/radar-media-spike/result.json','utf8')).plan,alignment=JSON.parse(await fs.readFile('/tmp/radar-explainer-spike/alignment.json','utf8')),timeline=timelineFor(plan,alignment,29.04),audio=(await pool.query('SELECT checkpoint FROM social_media_generations WHERE id=$1',[v.narrationId])).rows[0].checkpoint.audioUrl,results:any[]=[];const check=async(name:string,fn:()=>Promise<any>)=>{try{results.push({name,pass:true,detail:await fn()})}catch(e:any){results.push({name,pass:false,error:e.stack})}console.log(JSON.stringify(results.at(-1)))};const dirs=async()=>new Set((await fs.readdir(os.tmpdir())).filter(n=>n.startsWith('radar-media-')));const unlocked=async()=>{const c=await pool.connect();try{assert((await c.query('SELECT pg_try_advisory_lock(71839211) ok')).rows[0].ok);await c.query('SELECT pg_advisory_unlock(71839211)')}finally{c.release()}};
