import{db,pool,schema as S}from'../../../src/server/db/index';import{and,eq}from'drizzle-orm';import fs from'node:fs/promises';import'../../../src/server/jobs/all';import{runJobNow}from'../../../src/server/jobs/queue';const f=JSON.parse(await fs.readFile('.data/generated-media-qa/fixture.json','utf8'));let ran=0;for(let round=0;round<8;round++){const all=await db.select().from(S.jobs).where(and(eq(S.jobs.businessId,f.businessId),eq(S.jobs.status,'queued')));let jobs=all.filter(j=>['social.generate','social.media'].includes(j.kind));const target=process.argv[2];if(target){const ids=(await pool.query('SELECT id FROM social_media_generations WHERE business_id=$1 AND consumers @> $2::jsonb',[f.businessId,JSON.stringify([{packId:target}])])).rows.map(r=>r.id);jobs=jobs.filter(j=>j.kind==='social.media'&&ids.includes(j.payload.generationId));}if(!jobs.length)break;for(const j of jobs){await runJobNow(j.id);ran++;}}console.log(JSON.stringify({ran}));await pool.end();process.exit(0);
