import assert from'node:assert/strict';import fs from'node:fs/promises';import{spawnSync}from'node:child_process';import{randomUUID}from'node:crypto';import{db,pool,schema as S}from'../../../src/server/db/index';import{eq}from'drizzle-orm';import{getPack}from'../../../src/server/services/social/generate';import{prepareMedia,generateMedia,runMediaGeneration,collectMediaCache,mediaNotes}from'../../../src/server/services/social/media/index';import{sourceFor}from'../../../src/server/services/social/media/planner';import{hash,VOICE,narrationSettings,scriptOf,validatePlan}from'../../../src/server/services/social/media/model';import{timelineFor}from'../../../src/server/services/social/media/timeline';import{putObject,readStoredBounded,storedKey}from'../../../src/server/services/storage';import{env}from'../../../src/server/env';
const f=JSON.parse(await fs.readFile('.data/generated-media-qa/fixture.json','utf8')),out='.factory/generated-social-media/qa',results:any[]=[];const plan=validatePlan(JSON.parse(await fs.readFile('/tmp/radar-media-spike/result.json','utf8')).plan),alignment=JSON.parse(await fs.readFile('/tmp/radar-explainer-spike/alignment.json','utf8')),audio=await fs.readFile('/tmp/radar-explainer-spike/narration.mp3');const pack='qa-brian-'+randomUUID(),bid=f.businessId;let narrationId=randomUUID(),generationId:string,video:any;const originalFetch=globalThis.fetch;let network=0;globalThis.fetch=async()=>{network++;throw Error('External network prohibited in cached real-render QA')};
