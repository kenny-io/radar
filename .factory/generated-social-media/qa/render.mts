try{
await check('M1/M5 actual authentic cached Brian audio drives real MP4 render and attaches all three targets',async()=>{const source={kind:'idea',label:scriptOf(plan)};await db.insert(S.socialPacks).values({id:pack,businessId:bid,data:{id:pack,name:'Cached Brian explanation',source,created:new Date().toISOString().slice(0,10),style:'branded',auto:false,order:['instagram','tiktok','youtube'],posts:Object.fromEntries(['instagram','tiktok','youtube'].map(k=>[k,{text:'Owner description',style:'branded',seed:1,imageUrl:null,copiedAt:null,v:0,...(k==='tiktok'?{publishOptions:{tiktok:{privacyLevel:'SELF_ONLY',consent:true}}}:{})}]))}as any});const prep=await prepareMedia(bid,pack,['instagram','tiktok','youtube']);const row=(await pool.query('SELECT * FROM social_media_generations WHERE business_id=$1 AND request_version=$2',[bid,prep.requestId])).rows[0];await runMediaGeneration(bid,row.id);const freshSource=await sourceFor(bid,pack);await pool.query("UPDATE social_media_generations SET source_hash=$2,checkpoint=checkpoint||$3::jsonb WHERE id=$1",[row.id,hash(freshSource),JSON.stringify({source:freshSource,plan})]);const key=hash({script:scriptOf(plan),voice:VOICE,model:env.elevenlabsModel,settings:narrationSettings(),format:'mp3_44100_128',paidNonce:undefined});const existing=(await pool.query("SELECT id FROM social_media_generations WHERE business_id=$1 AND kind='narration' AND cache_key=$2",[bid,key])).rows[0];if(existing)narrationId=existing.id;const audioUrl=await putObject(`${bid}/social-media/${narrationId}/audio.mp3`,audio,'audio/mpeg');await pool.query("INSERT INTO social_media_generations(id,business_id,kind,cache_key,source_hash,status,stage,request_version,checkpoint) VALUES($1,$2,'narration',$3,$3,'ready','audio_saved',$4,$5) ON CONFLICT(business_id,kind,cache_key) DO NOTHING",[narrationId,bid,key,randomUUID(),{audioUrl,alignment,timeline:{duration:29.04}}]);const g=await generateMedia(bid,pack,['instagram','tiktok','youtube'].map(platform=>({platform,format:'video'}))as any,prep.requestId);assert.equal(new Set(g.generationIds).size,1);generationId=g.generationIds[0];const [a,b]=await Promise.all([runMediaGeneration(bid,generationId),runMediaGeneration(bid,generationId)]);assert([a,b].some(x=>x.ready));assert([a,b].some(x=>x.skipped));const p=(await getPack(bid,pack))!;for(const k of['instagram','tiktok','youtube']as const){assert(p.posts[k]!.video);assert.equal(p.posts[k]!.video!.url,p.posts.youtube!.video!.url);assert.equal(p.posts[k]!.slides,null);assert.equal(p.posts[k]!.generatedMedia?.aiGenerated,true)}assert.equal(p.posts.tiktok!.publishOptions!.tiktok!.consent,false);assert.equal(p.posts.tiktok!.publishOptions!.tiktok!.privacyLevel,'SELF_ONLY');assert.equal(p.posts.youtube!.publishOptions?.privacy,undefined);assert.equal(p.posts.youtube!.publishOptions?.madeForKids,undefined);video=p.posts.youtube!.video;const media=await readStoredBounded(bid,video.url,100*1024*1024);assert(media);await fs.writeFile(out+'/actual-cached-brian.mp4',media.body);await fs.writeFile('.data/generated-media-qa/video-pack.json',JSON.stringify({packId:pack,generationId,narrationId,video}));assert.equal(network,0);return{duration:video.durationSec,bytes:media.body.length,targets:3,sharedRender:true,freshTtsRequests:0,historicalSpeed:narrationSettings().speed}});
await check('M8 real output probes H264/AAC24fps1080x1920 and full-decodes with non-silent safe audio',async()=>{const file=out+'/actual-cached-brian.mp4',run=(bin:string,args:string[])=>{const r=spawnSync(bin,args,{encoding:'utf8',env:{PATH:process.env.PATH!},maxBuffer:10*1024*1024});assert.equal(r.status,0,r.stderr);return r.stdout+r.stderr};const probe=JSON.parse(run('/opt/homebrew/bin/ffprobe',['-v','error','-show_streams','-show_format','-of','json',file]));const v=probe.streams.find((s:any)=>s.codec_type==='video'),a=probe.streams.find((s:any)=>s.codec_type==='audio');assert.equal(v.codec_name,'h264');assert.equal(a.codec_name,'aac');assert.equal(v.width,1080);assert.equal(v.height,1920);assert.equal(v.r_frame_rate,'24/1');assert(Number(probe.format.duration)<180);run('/opt/homebrew/bin/ffmpeg',['-v','error','-i',file,'-f','null','-']);const levels=run('/opt/homebrew/bin/ffmpeg',['-hide_banner','-nostats','-i',file,'-vn','-af','volumedetect','-f','null','-']);const peak=Number(levels.match(/max_volume:\s*(-?[\d.]+) dB/)?.[1]);assert(peak< -0.1&&peak> -45);await fs.writeFile(out+'/probe.json',JSON.stringify(probe,null,2));await fs.writeFile(out+'/audio-levels.txt',levels);const timeline=timelineFor(plan,alignment,29.04);for(const[name,t]of[['opening',1],['handoff',timeline.scenes[1].start+.05],['revisit',timeline.scenes[2].cues.find(c=>c.kind==='revisit')!.start+.2],['final',timeline.duration-.5]]as const)run('/opt/homebrew/bin/ffmpeg',['-v','error','-y','-ss',String(t),'-i',file,'-frames:v','1',out+'/frame-'+name+'.jpg']);return{fullDecode:true,peakDb:peak,duration:Number(probe.format.duration)}});
await check('M4/M5 downloaded script/captions/alignment preserve authentic spoken words and exact cue timing',async()=>{const script=await mediaNotes(bid,generationId,'script'),vtt=await mediaNotes(bid,generationId,'captions'),notes=await mediaNotes(bid,generationId,'sources');assert.equal(script.text,scriptOf(plan));assert(vtt.text.startsWith('WEBVTT'));const timeline=timelineFor(plan,alignment,29.04),words=(s:string)=>s.toLowerCase().match(/[\p{L}\p{N}]+/gu)?.join(' ');assert.equal(words(timeline.captions.map(c=>c.text).join(' ')),words(script.text));assert(timeline.scenes.every(s=>s.cues.length>0));for(const art of['script','sources','storyboard','captions','alignment']){const n=await mediaNotes(bid,generationId,art);await fs.writeFile(out+'/real-'+n.filename,n.text)}assert(notes.text.includes('owner-provided'));return{allWordsOnce:true,scenes:timeline.scenes.length,cues:timeline.scenes.reduce((n,s)=>n+s.cues.length,0)}});
await check('M5/M6 cache GC preserves narration referenced transitively by attached video and uncertain paid tombstone',async()=>{await pool.query("UPDATE social_media_generations SET updated_at=now()-interval '2 days' WHERE id=ANY($1::uuid[])",[[generationId,narrationId]]);const uncertain=randomUUID(),orphan=randomUUID();for(const[gid,kind,status,stage]of[[uncertain,'narration','needs_attention','narration_dispatched'],[orphan,'carousel','cancelled','Cancelled']])await pool.query("INSERT INTO social_media_generations(id,business_id,kind,cache_key,source_hash,status,stage,request_version,updated_at) VALUES($1,$2,$3,$4,$4,$5,$6,$7,now()-interval '2 days')",[gid,bid,kind,gid,status,stage,randomUUID()]);await collectMediaCache();assert.equal((await pool.query('SELECT id FROM social_media_generations WHERE id=ANY($1::uuid[])',[[generationId,narrationId,uncertain]])).rowCount,3);assert.equal((await pool.query('SELECT id FROM social_media_generations WHERE id=$1',[orphan])).rowCount,0);assert(await readStoredBounded(bid,(await pool.query('SELECT checkpoint FROM social_media_generations WHERE id=$1',[narrationId])).rows[0].checkpoint.audioUrl,12*1024*1024));assert.equal(network,0);return{transitiveAudioPreserved:true,uncertainPreserved:true,cancelledOrphanCollected:true}});
}finally{globalThis.fetch=originalFetch;await fs.writeFile(out+'/render-results.json',JSON.stringify({at:new Date().toISOString(),results},null,2));await pool.end();}process.exit(results.some(x=>!x.pass)?1:0);
