import assert from'node:assert/strict';import fs from'node:fs/promises';import{pool}from'../../../src/server/db/index';import{getPack,updatePack}from'../../../src/server/services/social/generate';import{prepareMedia,generateMedia,runMediaGeneration}from'../../../src/server/services/social/media';import{readStoredBounded}from'../../../src/server/services/storage';const f=JSON.parse(await fs.readFile('.data/generated-media-qa/fixture.json','utf8')),v=JSON.parse(await fs.readFile('.data/generated-media-qa/video-pack.json','utf8'));const before=(await getPack(f.businessId,v.packId))!,id=before.posts.youtube!.generatedMedia!.id;let network=0;const original=globalThis.fetch;globalThis.fetch=async()=>{network++;throw Error('No new provider request allowed')};try{await updatePack(f.businessId,v.packId,p=>({...p,posts:{...p.posts,youtube:{...p.posts.youtube!,text:'Owner changes only the platform caption; the source explanation stays the same.'}}}));const prep=await prepareMedia(f.businessId,v.packId,['youtube']);const row=(await pool.query('SELECT id FROM social_media_generations WHERE business_id=$1 AND request_version=$2',[f.businessId,prep.requestId])).rows[0];assert.deepEqual(await runMediaGeneration(f.businessId,row.id),{prepared:true});const start=await generateMedia(f.businessId,v.packId,[{platform:'youtube',format:'video'}],prep.requestId);assert.equal(start.generationIds[0],id);assert.deepEqual(await runMediaGeneration(f.businessId,id),{ready:true});const after=(await getPack(f.businessId,v.packId))!;assert.equal(after.posts.youtube!.video!.url,before.posts.youtube!.video!.url);assert.equal((await pool.query("SELECT id FROM social_media_generations WHERE business_id=$1 AND kind='narration' AND checkpoint ? 'audioUrl'",[f.businessId])).rowCount,1);assert.equal(network,0);const r={at:new Date().toISOString(),passed:['same_source_output_cache_reused_after_caption_edit','same_audio_cache_preserved','zero_new_provider_requests'],sameGeneration:true};await fs.writeFile('.factory/generated-social-media/qa/reuse-results.json',JSON.stringify(r,null,2));console.log(JSON.stringify(r))}finally{globalThis.fetch=original;await pool.end()}
