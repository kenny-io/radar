import assert from'node:assert/strict';import fs from'node:fs/promises';import{randomUUID}from'node:crypto';import{pool}from'../../../src/server/db/index';import{collectMediaCache}from'../../../src/server/services/social/media';import{readStoredBounded}from'../../../src/server/services/storage';
const f=JSON.parse(await fs.readFile('.data/generated-media-qa/fixture.json','utf8')),v=JSON.parse(await fs.readFile('.data/generated-media-qa/video-pack.json','utf8'));const uncertain=randomUUID(),orphan=randomUUID();for(const[id,kind,status,stage]of[[uncertain,'narration','needs_attention','narration_dispatched'],[orphan,'carousel','cancelled','Cancelled']])await pool.query("INSERT INTO social_media_generations(id,business_id,kind,cache_key,source_hash,status,stage,request_version,updated_at) VALUES($1,$2,$3,$4,$4,$5,$6,$7,now()-interval '2 days')",[id,f.businessId,kind,id,status,stage,randomUUID()]);
let network=0;const previous=globalThis.fetch;globalThis.fetch=async()=>{network++;throw Error('No external request permitted')};
try{await pool.query("UPDATE social_media_generations SET updated_at=now()-interval '2 days' WHERE id=ANY($1::uuid[])",[[v.generationId,v.narrationId]]);await collectMediaCache();assert.equal((await pool.query('SELECT id FROM social_media_generations WHERE id=ANY($1::uuid[])',[[v.generationId,v.narrationId,uncertain]])).rowCount,3);assert.equal((await pool.query('SELECT id FROM social_media_generations WHERE id=$1',[orphan])).rowCount,0);const audio=(await pool.query('SELECT checkpoint FROM social_media_generations WHERE id=$1',[v.narrationId])).rows[0].checkpoint.audioUrl;assert(await readStoredBounded(f.businessId,audio,12*1024*1024));assert.equal(network,0);const r={at:new Date().toISOString(),passed:['attached_output_keeps_transitive_narration_and_audio','uncertain_paid_tombstone_survives','cancelled_unreferenced_orphan_collected'],externalRequests:0};await fs.writeFile('.factory/generated-social-media/qa/cache-results.json',JSON.stringify(r,null,2));console.log(JSON.stringify(r));}finally{globalThis.fetch=previous;await pool.end()}
